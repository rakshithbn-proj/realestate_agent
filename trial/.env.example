# Copy to .env and fill in. Never commit .env.

# Apify API token — console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=

# Dashboard auth token (any long random string). Empty disables auth (local dev only).
DASHBOARD_TOKEN=

# Daily scrape time (IST)
SCRAPE_HOUR=6
SCRAPE_MINUTE=30

# Set false to disable the scheduler (manual runs via dashboard button only)
SCHEDULER_ENABLED=true

# Listings per source per run (raise once cost is confirmed negligible)
MAX_RESULTS=300
