# Copy to .env and fill in. Never commit .env.

# --- Postgres (compose creates this user/db; app connects via the db service) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas

# App's SQLAlchemy URL. Inside compose: host is "db". Local dev: 127.0.0.1.
DATABASE_URL=postgresql+psycopg://atlas:change-me@127.0.0.1:5432/atlas

# --- API auth (required — every non-health endpoint needs "Authorization: Bearer <token>") ---
ATLAS_API_TOKEN=generate-a-long-random-token

# --- Caddy (VPS deploy: your domain; Caddy gets certificates automatically) ---
ATLAS_DOMAIN=localhost

# --- Phase 1+ ---
# Apify scraping token (portal collectors). Put the REAL value in .env, never here.
# REQUIRED on the VPS: compose refuses to start without it, so a deploy can't
# come up with a permanently dead portal scraper.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# In-process APScheduler: the thing that actually collects daily on the VPS.
# Compose defaults this to 1; set 0 only if driving ingestion from host cron.
ATLAS_ENABLE_SCHEDULER=1

# Active listings unseen this many days are marked removed (staleness sweep).
# STALE_AFTER_DAYS=7

# --- Phase 2 (daily briefing) ---
# Investor profile — drives capital-aware ranking (atlas/profile.py holds the
# defaults; override here only to change them without a code edit).
# ATLAS_CAPITAL_MIN_INR=1500000
# ATLAS_CAPITAL_MAX_INR=2500000
# ATLAS_LTV=0.70
# RESEND_API_KEY=
# ATLAS_DIGEST_TO=you@example.com
# HEALTHCHECKS_PING_URL=
