# Copy to .env and fill in. Never commit .env.

# --- Postgres (compose creates this user/db; app connects via the db service) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas

# App's SQLAlchemy URL. Inside compose: host is "db". Local dev: 127.0.0.1.
DATABASE_URL=postgresql+psycopg://atlas:change-me@127.0.0.1:5432/atlas

# --- API auth (required — every non-health endpoint needs "Authorization: Bearer <token>") ---
ATLAS_API_TOKEN=generate-a-long-random-token

# --- Caddy (VPS deploy: your domain; Caddy gets certificates automatically) ---
ATLAS_DOMAIN=localhost

# --- Phase 1+ ---
# Apify scraping token (portal collectors). Put the REAL value in .env, never here.
# REQUIRED on the VPS: compose refuses to start without it, so a deploy can't
# come up with a permanently dead portal scraper.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# In-process APScheduler: the thing that actually collects daily on the VPS.
# Compose defaults this to 1; set 0 only if driving ingestion from host cron.
ATLAS_ENABLE_SCHEDULER=1

# Active listings unseen this many days are marked removed (staleness sweep).
# STALE_AFTER_DAYS=7

# --- Phase 2 (daily briefing) ---
# Investor profile — drives capital-aware ranking (atlas/profile.py).
# Modelled reserve-first: the emergency fund is NEVER counted as deployable,
# because spending it is how an owner becomes a forced seller. Deployable =
# liquid_total - reserved. Keep these current: a stale figure mis-filters the
# briefing in both directions, which is why the digest prints its assumption.
# ATLAS_LIQUID_TOTAL_INR=2500000        # MFs + stocks + cash
# ATLAS_RESERVED_INR=600000             # emergency fund (raise it once an EMI exists)
# ATLAS_MONTHLY_CONTRIBUTION_INR=0      # saved toward the goal each month
# ATLAS_LTV=0.70
# Long-term equity you would not normally break into, but could for an
# exceptional deal. Kept apart from the reserve so `atlas.cli plan` can cost
# the unlock (LTCG) instead of pretending the money is either free or absent.
# ATLAS_COMMITTED_INR=0
# ATLAS_COMMITTED_GAIN_FRACTION=0.35    # unrealised-gain share of the above

# --- Seller-motivation extraction (the "why selling" score factor) ---
# Haiku over the Batch API, a few cents a day across ~650 listings. UNSET IS
# A SUPPORTED STATE: the seller_motivation factor abstains for every listing
# and the score renormalises over the rest, rather than scoring every seller
# as unmotivated because nobody asked.
# ANTHROPIC_API_KEY=

# --- The daily briefing (atlas/report.py, 07:15 IST) ---
# Resend: one API key, 3k/month free, no domain verification needed to send
# to yourself. Unset means the digest is still built and stored, just not
# delivered — logged, never a silent no-op.
# RESEND_API_KEY=
# ATLAS_DIGEST_TO=you@example.com
# ATLAS_DIGEST_FROM=Atlas <onboarding@resend.dev>
# Signs the thumbs-up/down links in the email. A mail client cannot send an
# Authorization header, so each link carries its own HMAC instead; with no
# secret set the links are omitted and the endpoint rejects everything.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATLAS_FEEDBACK_SECRET=
# ATLAS_PUBLIC_BASE_URL=https://atlas.example.com
# External dead-man's switch (plan §7): pinged on successful delivery, so a
# missed ping tells you the briefing never arrived.
# HEALTHCHECKS_PING_URL=
